{
  "name": "mystrip_watchmaster",
  "version": "0.1.2",
  "description": "Live log of the climate master interface's values (seat and steering wheel heating) while the heating buttons are pressed; read-only",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 30,
    "memoryThresholdKB": 131072,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "MSWM",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "owner",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID8"
  ]
}
